# ProjectHub web container (ADR 0012): serves the built app and forwards /api and /health to the API, so the
# browser only ever talks to one origin. TLS ends at the ingress in front of this container.
# ${PROJECTHUB_API_UPSTREAM} is filled in by the nginx image at start (envsubst).

server_tokens off;

# Access log without client address and query string (ADR 0015): the hubs carry the access token in the query
# string, and the address is personal data nobody here needs. $uri is the path without the query.
log_format projecthub '$time_iso8601 "$request_method $uri" $status $body_bytes_sent $request_time';

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Keep the scheme the ingress saw; without an ingress (local) it is this connection's.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

# Pass on the client address the ingress appended. The API trusts exactly one hop (ForwardLimit 1).
map $http_x_forwarded_for $forwarded_for {
    default $http_x_forwarded_for;
    ''      $remote_addr;
}

server {
    listen 8080;
    root /usr/share/nginx/html;
    access_log /var/log/nginx/access.log projecthub;

    # Uploads up to PROJECTHUB_ATTACHMENT_MAX_BYTES (100 MB); the API enforces the real limits per endpoint.
    client_max_body_size 110m;

    location /api/ {
        proxy_pass ${PROJECTHUB_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        # Realtime hubs upgrade to WebSockets and stay open.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;
        proxy_request_buffering off;
    }

    location /health/ {
        proxy_pass ${PROJECTHUB_API_UPSTREAM};
        proxy_set_header Host $host;
    }

    # Built assets carry a content hash in their name.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
