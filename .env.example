# App
ASPNETCORE_ENVIRONMENT=Development
PROJECTHUB_DB_CONNECTION=Host=localhost;Port=5432;Database=projecthub;Username=projecthub;Password=projecthub_dev
REDIS_CONNECTION=localhost:6379
MESSAGE_TRANSPORT=InMemory
# Applies database/migrations/*.sql on API startup. Never enable in production (human review gate).
PROJECTHUB_APPLY_MIGRATIONS=true

# Microsoft Entra ID - DEV placeholders only
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=__SET_VIA_SECRET_STORE__

# Microsoft Graph
MICROSOFT_GRAPH_SENDER_MAILBOX=notifications@example.invalid

# Webex - DEV placeholders only
WEBEX_CLIENT_ID=__SET_VIA_SECRET_STORE__
WEBEX_CLIENT_SECRET=__SET_VIA_SECRET_STORE__
WEBEX_REDIRECT_URI=https://localhost:5001/api/v1/integrations/webex/oauth/callback

# Azure (development placeholders)
AZURE_KEY_VAULT_URI=https://example.invalid/
AZURE_STORAGE_ACCOUNT=__SET_VIA_SECRET_STORE__
AZURE_SERVICE_BUS=__SET_VIA_SECRET_STORE__
