# App
ASPNETCORE_ENVIRONMENT=Development
PROJECTHUB_DB_CONNECTION=Host=localhost;Port=5432;Database=projecthub;Username=projecthub;Password=projecthub_dev
REDIS_CONNECTION=localhost:6379
MESSAGE_TRANSPORT=InMemory
# Applies database/migrations/*.sql on API startup. Never enable in production (human review gate).
PROJECTHUB_APPLY_MIGRATIONS=true
# Inserts synthetic organizations, users, teams and projects (Development only).
PROJECTHUB_SEED_DEVELOPMENT_DATA=true
# Local attachment storage (development). Production will use Azure Blob Storage (DEC-017).
PROJECTHUB_ATTACHMENT_DIRECTORY=.data/attachments
PROJECTHUB_ATTACHMENT_MAX_BYTES=104857600
# Link to the web app in notification mails and calendar entries.
PROJECTHUB_APP_URL=http://localhost:5173
# How outbox mails leave ProjectHub: fake (default, nothing is sent) or graph (ADR 0010,
# docs/integrations/microsoft-365-setup.md). Seconds between outbox checks when not woken (0 = worker off).
PROJECTHUB_MAIL_TRANSPORT=fake
PROJECTHUB_MAIL_POLL_SECONDS=15

# Whiteboard snapshots (Development: local directory; production: Azure Blob Storage, ADR 0009)
PROJECTHUB_WHITEBOARD_DIRECTORY=.data/whiteboards
# Seconds between compaction runs (0 = off) and the quiet time before a whiteboard is compacted
PROJECTHUB_WHITEBOARD_COMPACTION_SECONDS=5
PROJECTHUB_WHITEBOARD_QUIET_SECONDS=5

# Microsoft Entra ID - DEV placeholders only
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=__SET_VIA_SECRET_STORE__

# Microsoft Graph (only used with PROJECTHUB_MAIL_TRANSPORT=graph)
MICROSOFT_GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Empty = managed identity. Never commit a real value.
MICROSOFT_GRAPH_CLIENT_SECRET=__SET_VIA_SECRET_STORE__
MICROSOFT_GRAPH_SENDER_MAILBOX=notifications@example.invalid

# Webex (ADR 0011): off | fake | bot. Default: fake in Development, off elsewhere.
PROJECTHUB_WEBEX_TRANSPORT=fake
# Only used with PROJECTHUB_WEBEX_TRANSPORT=bot. Never commit a real value.
WEBEX_BOT_TOKEN=__SET_VIA_SECRET_STORE__
WEBEX_WEBHOOK_SECRET=__SET_VIA_SECRET_STORE__
# Public address of the API that Webex calls webhooks on
PROJECTHUB_PUBLIC_API_URL=https://projecthub.example.invalid

# Webex OAuth per person - not used (bot instead, ADR 0011), kept for a possible later integration
WEBEX_CLIENT_ID=__SET_VIA_SECRET_STORE__
WEBEX_CLIENT_SECRET=__SET_VIA_SECRET_STORE__
WEBEX_REDIRECT_URI=https://localhost:5001/api/v1/integrations/webex/oauth/callback

# Azure (development placeholders)
AZURE_KEY_VAULT_URI=https://example.invalid/
AZURE_STORAGE_ACCOUNT=__SET_VIA_SECRET_STORE__
AZURE_SERVICE_BUS=__SET_VIA_SECRET_STORE__
