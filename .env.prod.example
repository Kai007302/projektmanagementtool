# Settings for docker-compose.prod.yml (docs/SELF_HOSTING.md). Copy to .env next to the compose file.
# .env holds secrets: never commit it.

# Public address of ProjectHub; DNS must point at this server (Caddy fetches the TLS certificate for it).
PROJECTHUB_DOMAIN=projecthub.example.com

# Database password, e.g. from: openssl rand -base64 32
POSTGRES_PASSWORD=

# Microsoft Entra ID app registration (docs/SELF_HOSTING.md, "App-Registrierung").
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Only if the exposed API scope is not api://<client id>/access_as_user
ENTRA_API_SCOPE=

# first-sign-in: people of the tenant get a user at their first sign-in, the first one becomes admin.
# off: only users that already exist may sign in.
PROJECTHUB_USER_PROVISIONING=first-sign-in
PROJECTHUB_ORGANIZATION_NAME=ProjectHub

# Notification mails: fake (none are sent, notifications stay in the app) or graph (docs/integrations/microsoft-365-setup.md).
PROJECTHUB_MAIL_TRANSPORT=fake
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_SENDER_MAILBOX=

# Webex bot (docs/integrations/webex-setup.md): off or bot
PROJECTHUB_WEBEX_TRANSPORT=off
WEBEX_BOT_TOKEN=
WEBEX_WEBHOOK_SECRET=

# Telemetry to an OTLP collector (ADR 0013). Empty: JSON logs only (docker compose logs).
OTEL_EXPORTER_OTLP_ENDPOINT=

# Data protection (docs/LEGAL.md). Privacy notice: copy deploy/legal/datenschutz.vorlage.html to legal/datenschutz.html,
# fill it in, and keep the default below. Imprint: link to your existing one, if you need one at all.
PROJECTHUB_PRIVACY_NOTICE_URL=/rechtliches/datenschutz.html
PROJECTHUB_IMPRINT_URL=
# Days (default 1095 = 3 years) until notifications, project activity and audit entries are deleted; 0 keeps them forever.
PROJECTHUB_RETENTION_NOTIFICATION_DAYS=1095
PROJECTHUB_RETENTION_ACTIVITY_DAYS=1095
PROJECTHUB_RETENTION_AUDIT_DAYS=1095
